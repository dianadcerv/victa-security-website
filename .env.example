# Google Apps Script Web App URL (Deploy > Web app)
# Used by both the Request Form (leads) and Discovery Intake (responses)
REACT_APP_INTAKE_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Must match INTAKE_SECRET in Apps Script project properties
REACT_APP_INTAKE_SECRET=choose-a-long-random-string

# Optional in Apps Script script properties (not needed in Vercel):
# INTAKE_BASE_URL=https://www.victasecuritysolutions.com/intake
# NOTIFY_EMAIL=you@example.com
